                    ],
                    [
                        "1",
                        "1",
                        "1"
                    ]
                ],
                "highlightedCells": [
                    2
                ]
            },
            "multipleChoice": {
                "answers": [
                    {
                        "text": "2",
                        "isCorrect": false,
                        "feedback": "Think again, the formula is x = t, y = t², so if we plug in t = -2, what do we get?"
                    },
                    {
                        "text": "4",
                        "isCorrect": true,
                        "feedback": "Correct! y = (-2)² = 4."
                    },
                    {
                        "text": "-4",
                        "isCorrect": false,
                        "feedback": "Think again, the formula is x = t, y = t², so if we plug in t = -2, what do we get?"
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Next: what are both coordinates (x,y) when t = –1?",
            "contentType": "Table",
            "interaction": "MultipleChoice",
            "table": {
                "header": [
                    "t",
                    "x",
                    "y"
                ],
                "data": [
