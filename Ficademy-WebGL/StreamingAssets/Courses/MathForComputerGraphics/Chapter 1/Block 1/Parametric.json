                    {
                        "text": "x = -1, y = -1",
                        "isCorrect": false
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Finally: what is the x-coordinate when t = 0?",
            "contentType": "Table",
            "interaction": "MultipleChoice",
            "table": {
                "header": [
