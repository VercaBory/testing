                ]
            },
            "multipleChoice": {
                "answers": [
                    {
                        "text": "x = -1, y = 1",
                        "isCorrect": true,
                        "feedback": "Great! t = -1 gives x = -1, y = 1"
                    },
                    {
                        "text": "x = 1, y = -1",
                        "isCorrect": false
