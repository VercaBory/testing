            "message": "Let’s finish up with a short recap",
            "contentType": "OnlyText",
            "interaction": "Flashcards",
            "flashcards": [
                {
                    "frontText": "What is a parameter in parametric equations?",
                    "backText": "It’s an independent variable (often t) that defines both x and y."
                },
                {
                    "frontText": "True or False: Parametric definitions only exist in 2D.",
