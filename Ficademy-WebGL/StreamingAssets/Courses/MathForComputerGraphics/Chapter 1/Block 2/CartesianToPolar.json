        {
            "speaker": "Teacher",
            "message": "Oh no, but our rocket’s current position is given in Cartesian coordinates [-2√3, 2], but all nearby stars are listed in polar coordinates.",
            "contentType": "Geometry",
            "interaction": "None"
        },
        {
            "speaker": "Teacher",
            "message": "Stars: (4, 0°), (4, 40°), (4, 90°), (4, 110°)",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Assistant",
            "message": "We need to convert our position before we can navigate.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Assistant",
            "message": "Convert the rocket’s position [-2√3, 2] into polar coordinates (r, θ). What is the result?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "ans1",
                        "text": "r = 2 , θ ≈ 330°",
                        "isCorrect": false,
                        "feedback": "The formula is: r = √(x² + y²), θ = arctan(y/x) "
                    },
                    {
                        "id": "ans2",
                        "text": "r = 4, θ ≈ -30°",
                        "isCorrect": false,
                        "feedback": "This is the wrong quadrant."
                    },
                    {
                        "id": "ans3",
                        "text": "r = 2, θ ≈ 150°",
                        "isCorrect": false,
                        "feedback": "Check your distance: r = √(x² + y²) "
                    },
                    {
                        "id": "ans4",
                        "text": "r = 4 , θ ≈ 150°",
                        "isCorrect": true,
                        "feedback": "Pythagorean theorem and arctan rules! Just be careful about the quadrant."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Well done! We get the radius using the Pythagorean theorem, and the angle from the arctan.",
            "contentType": "Image",
            "interaction": "Continue",
            "imageData": {
                "imageName": "cartesianToPolar.png",
                "description": "Triangle showing conversion formulas from Cartesian to polar coordinates",
                "height": 400
            },
            "saveFact": true,
            "factData": {
                "text1": "Convert Cartesian to Polar",
                "text2": "r = √(x² + y²), θ = arctan(y/x) (adjust for quadrant)",
                "speaker": "Teacher"
            }
        },
        {
            "speaker": "Teacher",
