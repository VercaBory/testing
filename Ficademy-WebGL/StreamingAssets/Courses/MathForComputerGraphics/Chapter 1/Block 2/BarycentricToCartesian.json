        },
        {
            "speaker": "Teacher",
            "message": "Which formula correctly converts barycentric coordinates (α, β, γ) into Cartesian coordinates using positions of towers A, B, and C?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "f1",
                        "text": "P = α·A + β·B + γ·C",
                        "isCorrect": true,
                        "feedback": "Correct! That’s the definition of barycentric coordinates."
                    },
                    {
                        "id": "f2",
                        "text": "P = A + B + C",
                        "isCorrect": false,
                        "feedback": "Not quite — we need the weights (α, β, γ)."
                    },
                    {
                        "id": "f3",
                        "text": "P = α + β + γ",
                        "isCorrect": false,
                        "feedback": "That just checks the sum of weights, not the position."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "We know the towers’ positions are: A[0,0], B[4,0], C[0,3] and weights α = ½ , β = ¼ , γ = ¼ .",
            "contentType": "OnlyText",
            "interaction": "None"
        },
        {
            "speaker": "Teacher",
            "message": "First, let’s compute the x coordinate:\nx = α·Ax + β·Bx + γ·Cx = ½·0 + ¼·4 + ¼·0 = ?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "x2",
                        "text": "0",
                        "isCorrect": false,
                        "feedback": "Check the contribution of B again."
                    },
                    {
                        "id": "x3",
                        "text": "2",
                        "isCorrect": false,
                        "feedback": "Careful, α corresponds to A which is at (0,0)."
                    },
                    {
                        "id": "x1",
                        "text": "1",
                        "isCorrect": true,
                        "feedback": "Correct! The x coordinate is 1."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Now, let’s compute the y coordinate:\ny = α·Ay + β·By + γ·Cy = ½·0 + ¼·0 + ¼·3 = ?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "y1",
                        "text": "0.75",
                        "isCorrect": true,
                        "feedback": "Correct! The y coordinate is 0.75."
                    },
                    {
                        "id": "y2",
                        "text": "0",
                        "isCorrect": false,
                        "feedback": "Check again — γ applies to C(0,3)."
                    },
                    {
                        "id": "y3",
                        "text": "1.5",
                        "isCorrect": false,
                        "feedback": "Remember, α corresponds to A(0,0)."
                    }
                ]
            }
        },
