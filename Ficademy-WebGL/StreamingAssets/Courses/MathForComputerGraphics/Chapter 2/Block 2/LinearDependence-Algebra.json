        {
            "speaker": "Assistant",
            "message": "Do we remember something about rank?",
            "contentType": "OnlyText",
            "interaction": "Flashcards",
            "flashcards": [
                {
                    "frontText": "Rank of matrix in row echelon form equals…",
                    "backText": "…the number of non-zero rows."
                },
                {
                    "frontText": "The rank of a matrix tells us the dimension of…",
                    "backText": "…the vector space generated by its columns."
                }
            ]
        },
        {
            "speaker": "Assistant",
            "message": "And what was the rule we learned in linear algebra?",
            "contentType": "OnlyText",
            "interaction": "Pairing",
            "pairs": [
                {
                    "left": "If rank(A) = number of vectors",
                    "right": "independent"
