    "steps": [
        {
            "speaker": "Teacher",
            "message": "Welcome! Today we’ll learn about linear combinations.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Teacher",
            "message": "We are going to play with vectors u = (2, 1) and v = (-1, 3). \n First of all, what do we get if we sum them?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "text": "point [1, 4]",
                        "isCorrect": false,
                        "feedback": "No, the sum of two vectors is another vector, not a point."
                    },
                    {
                        "text": "vector (1, 4)",
                        "isCorrect": true
                    },
                    {
                        "text": "point [3, -2]",
                        "isCorrect": false,
                        "feedback": "No, the sum of two vectors is another vector, not a point."
                    },
                    {
                        "text": "vector (3, -2)",
                        "isCorrect": false,
                        "feedback": "That would be their difference"
                    }
                ]
            }
        },
        {
            "speaker": "Assistant",
            "message": "That’s easy, but I like to do my math graphically…",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Teacher",
            "message": "Imagine you’re standing at point [1, -1]. Walk along vector u and then along vector v.",
            "contentType": "Geometry",
            "interaction": "Continue",
            "geometry": {
                "isNewScene": true,
                "properties": {
                    "showGridLines": true,
                    "showAxes": true,
                    "showNumbers": true,
                    "gridBounds": {
                        "minX": -2,
                        "maxX": 4,
                        "minY": -2,
                        "maxY": 5
                    }
                },
                "geometryObjects": {
                    "Add": [
                        {
                            "id": "startPoint",
                            "objectType": "Point",
                            "pointData": {
                                "position": [
                                    1,
                                    -1
                                ],
                                "highlight": true
                            }
                        },
                        {
                            "id": "vecU",
                            "objectType": "Vector",
                            "vectorData": {
                                "start": [
                                    1,
                                    -1
                                ],
                                "end": [
                                    3,
                                    0
                                ],
                                "label": "u"
                            }
                        },
                        {
                            "id": "vecV",
                            "objectType": "Vector",
                            "vectorData": {
                                "start": [
                                    3,
                                    0
                                ],
                                "end": [
                                    2,
                                    3
                                ],
                                "label": "v"
                            }
                        }
                    ]
                }
            }
        },
        {
            "speaker": "Teacher",
            "message": "What point did you get to?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "text": "[2, 3]",
                        "isCorrect": true
                    },
                    {
                        "text": "[3, 0]",
                        "isCorrect": false
                    },
                    {
                        "text": "[0, 0]",
                        "isCorrect": false
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Exactly, now imagine the vector u+v as if we decided to walk to the point [2, 3] directly.",
            "contentType": "Geometry",
            "interaction": "Continue",
            "geometry": {
                "isNewScene": true,
                "properties": {
                    "showGridLines": true,
                    "showAxes": true,
                    "showNumbers": true,
                    "gridBounds": {
                        "minX": -2,
                        "maxX": 4,
                        "minY": -2,
                        "maxY": 5
                    }
                },
                "geometryObjects": {
                    "Add": [
                        {
                            "id": "startPoint",
                            "objectType": "Point",
                            "pointData": {
                                "position": [
                                    1,
                                    -1
                                ],
                                "highlight": true
                            }
                        },
                        {
                            "id": "vecU",
                            "objectType": "Vector",
                            "vectorData": {
                                "start": [
                                    1,
                                    -1
                                ],
                                "end": [
                                    3,
                                    0
                                ],
                                "label": "u"
                            }
                        },
                        {
                            "id": "vecV",
                            "objectType": "Vector",
                            "vectorData": {
                                "start": [
                                    3,
