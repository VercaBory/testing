                    ]
                }
            }
        },
        {
            "speaker": "Teacher",
            "message": "Before we can navigate, we need a basis. Pick two vectors that are independent and can span the plane.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Assistant",
            "message": "Let’s take the (-1, 2), which one should be the second?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "opt1",
                        "text": "(1, -2)",
                        "isCorrect": false,
                        "feedback": "This one is opposite to (-1, 2)."
                    },
                    {
                        "id": "opt2",
                        "text": "(2, -4)",
                        "isCorrect": false,
                        "feedback": "(2, -4) is a multiple of (-1, 2)."
                    },
                    {
                        "id": "opt3",
                        "text": "(3, 2)",
                        "isCorrect": true,
                        "feedback": "Correct! This vector is independent from (-1, 2)."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "In the standard basis {(1,0), (0,1)}, we would land by following the vector (7,2).",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Teacher",
            "message": "But we need to give the computer coordinates in the new basis {u=(-1,2), v=(3,2)}.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Assistant",
            "message": "How do we compute the coordinates in the new basis?",
            "contentType": "OnlyText",
            "interaction": "MultipleChoice",
            "multipleChoice": {
                "answers": [
                    {
                        "id": "wrong1",
                        "text": "Use dot product",
                        "isCorrect": false,
                        "feedback": "The result of a dot product is a scalar."
                    },
                    {
                        "id": "wrong2",
                        "text": "Take cross product",
                        "isCorrect": false,
                        "feedback": "Not applicable in 2D for coordinates."
                    },
                    {
                        "id": "correct",
                        "text": "Express as a linear combination of the basis vectors",
                        "isCorrect": true,
                        "feedback": "Yes! Express r = α*u + β*v."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Express (7, 2) as a linear combination of your chosen basis: r = α·(-1,2) + β·(3,2).",
            "contentType": "Image",
            "interaction": "MultipleChoice",
            "imageData": {
                "imageName": "vectorLanding.png",
                "height": 550
            },
            "multipleChoice": {
                "answers": [
                    {
                        "id": "a1",
                        "text": "α=-2, β=1",
                        "isCorrect": false,
                        "feedback": "Check your solution carefully."
                    },
                    {
                        "id": "a2",
                        "text": "α=1, β=2",
                        "isCorrect": false,
                        "feedback": "Not quite — recheck the combination."
                    },
                    {
                        "id": "a3",
                        "text": "α=-1, β=2",
                        "isCorrect": true,
                        "feedback": "Correct! This combination reaches the runway."
                    },
                    {
                        "id": "a4",
                        "text": "α=2, β=1",
                        "isCorrect": false,
                        "feedback": "Incorrect — check the contributions of each basis vector."
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Well done, we have to go one step in the negative u direction, and two steps in the v direction.",
            "contentType": "Geometry",
            "interaction": "Continue",
            "geometry": {
                "isNewScene": true,
                "properties": {
