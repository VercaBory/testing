                    },
                    {
                        "text": "A formula using a parameter t to define both x and y",
                        "isCorrect": false
                    },
                    {
                        "text": "A table listing all points in the set",
                        "isCorrect": false
                    },
                    {
                        "text": "A condition that points must satisfy, like x² + y² = 15",
                        "isCorrect": true
                    }
                ]
            }
        },
