            }
        },
        {
            "speaker": "Teacher",
            "message": "We can generate as many points as we want this way — the rule gives us the whole set.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Assistant",
            "message": "Explicit representations are like a recipe — you feed it x, and it tells you exactly where the point goes.",
            "contentType": "OnlyText",
            "interaction": "Continue"
        },
        {
            "speaker": "Teacher",
            "message": "Let’s match some explicit representation with the shapes they represent. (note: x ∈ ℝ)",
            "contentType": "OnlyText",
            "interaction": "Pairing",
            "pairs": [
                {
                    "id": 0,
                    "left": "S = {[x, x²]}",
                    "right": "Parabola"
                },
                {
                    "id": 1,
                    "left": "S = {[x, 3x + 1]}",
                    "right": "Line"
                },
                {
                    "id": 2,
                    "left": "S = {[x, sin(x)]}",
                    "right": "Wave"
                }
            ]
        },
        {
            "speaker": "Assistant",
            "message": "Let’s finish up with a short recap",
            "contentType": "OnlyText",
            "interaction": "Flashcards",
            "flashcards": [
                {
                    "frontText": "What is an explicit representation of a set of points?",
                    "backText": "A direct description of the set, e.g. by listing points or giving a formula that directly generates the points."
                },
                {
                    "frontText": "Is this an explicit equation? x² + y² = 1",
                    "backText": "No, that’s implicit."
                },
                {
                    "frontText": "Is this an explicit description? ‘All points where x is 0, and y ranges from 1 to 5’",
                    "backText": "Yes"
                },
                {
                    "frontText": "An explicit form tells me ...",
                    "backText": "… how to generate each point in the set."
                },
                {
                    "frontText": "Is this explicit form? \ny = x²",
                    "backText": "Yes"
                },
                {
                    "frontText": "Is this explicit form? \nS = {(1,2), (3,4), (5,6)}",
                    "backText": "Yes"
                },
                {
                    "frontText": "How does explicit form differ from implicit?",
                    "backText": "Explicit: directly generates the points. \nImplicit: gives a condition they must satisfy."
                }
            ]
        }
    ]
}