                        "isCorrect": true,
                        "feedback": "Correct! -1 + 2 = 1."
                    },
                    {
                        "text": "2",
                        "isCorrect": false
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "Now compute y when x = 2. (line: y = x + 2)",
            "contentType": "Table",
            "interaction": "MultipleChoice",
            "table": {
                "header": [
                    "x",
                    "y"
                ],
                "data": [
                    [
                        "-1",
