                    ],
                    [
                        "4",
                        ""
                    ]
                ],
                "highlightedCells": [
                    3
                ]
            },
            "multipleChoice": {
                "answers": [
                    {
                        "text": "4",
                        "isCorrect": true,
                        "feedback": "Yes! y = 2 + 2 = 4"
                    },
                    {
                        "text": "5",
                        "isCorrect": false
                    },
                    {
                        "text": "1",
                        "isCorrect": false
                    }
                ]
            }
        },
        {
            "speaker": "Teacher",
            "message": "And now for x = 4. (line: y = x + 2)",
            "contentType": "Table",
            "interaction": "MultipleChoice",
            "table": {
                "header": [
                    "x",
                    "y"
                ],
                "data": [
                    [
                        "-1",
