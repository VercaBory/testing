{
    "title": "Converting Polar to Cartesian",
    "description": "Pilot must convert star positions from polar to Cartesian coordinates to navigate.",
    "pathToSources": "Courses/MathForComputerGraphics/Chapter 1/Block 2/",
    "steps": [
        {
            "speaker": "Assistant",
            "message": "Captain, we located the stars on the radar. Let's go collect them!",
            "contentType": "Geometry",
            "interaction": "Continue",
            "geometry": {
                "isNewScene": true,
                "properties": {
                    "gridBounds": {
